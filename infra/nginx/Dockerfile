FROM nginx:1.31-alpine

# Удаляем дефолтный конфигурационный файл Nginx, 
# который идет "из коробки", чтобы он не конфликтовал с нашими настройками.
RUN rm /etc/nginx/conf.d/default.conf

# Копируем наш написанный nginx.conf из папки infra/nginx 
# внутрь образа по пути, где Nginx будет его искать.
COPY nginx.conf /etc/nginx/nginx.conf

# Явно указываем, что контейнер будет слушать 80-й порт.
# EXPOSE не открывает порт наружу автоматически, это скорее 
# документация для разработчиков и других инструментов.
EXPOSE 80

# Команда запуска Nginx. 
# Флаг "daemon off" обязателен для Docker, иначе Nginx запустится в фоне,
# и Docker подумает, что процесс завершился, остановив контейнер.
CMD ["nginx", "-g", "daemon off;"]