# Берем официальный легковесный образ Python
FROM python:3.14-slim

# Копируем бинарник uv из официального образа (это самый быстрый способ установить uv в Docker)
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

# Устанавливаем рабочую директорию (это решает проблемы с путями)
WORKDIR /project

# Сначала копируем только файлы с зависимостями
# Это нужно для кеширования слоев Docker: если зависимости не менялись, этот шаг пройдет мгновенно
COPY pyproject.toml uv.lock* ./

# Устанавливаем зависимости (флаг --system ставит пакеты глобально в контейнере, venv тут не нужен)
RUN uv pip install --system -r pyproject.toml

# Копируем папку app внутрь рабочей директории
COPY ./app ./app



# Указываем порт, который будет слушать приложение
EXPOSE 8000

# Команда для запуска сервера (при условии, что ты используешь импорты с app.)
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]