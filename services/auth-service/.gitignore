# ============================================================================
# Python Core Artifacts
# ============================================================================
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# ============================================================================
# VS Code Configuration
# ============================================================================
# Ignore the workspace settings folder completely
.vscode/
# Alternatively, if you want to share launch configurations but ignore personal settings:
# .vscode/settings.json
# .vscode/tasks.json
# .vscode/launch.json

# Workspace files
*.code-workspace

# ============================================================================
# Virtual Environments & Packages
# ============================================================================
# Default virtual environments
.venv/
venv/
ENV/
env/

# Pipenv, Poetry, and PDM lock / dynamic structures
.pypackages/
.poetry/
.pytest_cache/

# Distribution / packaging tools
bin/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
*.manifest
*.spec

# ============================================================================
# Environment Variables & Secrets (CRITICAL SECURITY)
# ============================================================================
.env
.env.*
*.env
secret_key.txt
credentials.json

# ============================================================================
# Testing and Coverage
# ============================================================================
htmlcov/
.tox/
.nosexml/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/

# ============================================================================
# Log Files and System Backups
# ============================================================================
*.log
pip-log.txt
pip-delete-this-directory.txt

# OS-specific temporary files
.DS_Store
Thumbs.db
